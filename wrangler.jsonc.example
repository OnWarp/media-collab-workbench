{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-collab-workbench",
  "main": "worker.js",
  "compatibility_date": "2026-07-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "media-collab-db", "database_id": "__D1_DATABASE_ID__" }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "media-collab-uploads" }
  ],
  "observability": { "enabled": true }
}
