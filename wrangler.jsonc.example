{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-collab-workbench",
  "main": "worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "APP_STATE", "class_name": "AppState" }
    ]
  },
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "media-collab-uploads" }
  ],
  "observability": { "enabled": true }
}
